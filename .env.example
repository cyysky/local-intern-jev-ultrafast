# Decision calls. Defaults to TypeSafe's hosted Jev; point it at any server that
# exposes the same /v1/systemone API, e.g. http://127.0.0.1:8011/v1 for a local one.
SYSTEMONE_BASE_URL=https://api.typesafe.ai/v1
# Needed by the hosted endpoint; leave empty for a local server without auth.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Seconds to wait for a model response; raise it for a slow local model.
MODEL_TIMEOUT_SECONDS=25
# Below this the text helper re-decides the field; 0 keeps every local answer.
THINKING_CONFIDENCE_THRESHOLD=0.7
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
